# Copy to .env and fill in ONE provider. Without any key the app runs in offline demo mode.

# LLM_PROVIDER=auto            # auto | anthropic | openai | offline

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# Optional tuning
# MAX_ROWS=500            # row cap on every query
# MAX_RETRIES=3           # SQL self-correction attempts
# MAX_ROWS_TO_LLM=30      # result rows sent to the LLM for summarising
# OUTPUT_DIR=outputs
